<Layouts.app flash={@flash}>
  <.header>
    About Helpdesk
    <:subtitle>Founded in {@founded} · {@team_size} people</:subtitle>
  </.header>

  <p class="mt-4">
    Helpdesk is the support desk we build in this training course.
  </p>

  <.stat_row
    stats={[
      {@team_size, "Team members"},
      {@founded, "Founded"}
    ]}
    divider
    class="mt-8"
  />
</Layouts.app>
