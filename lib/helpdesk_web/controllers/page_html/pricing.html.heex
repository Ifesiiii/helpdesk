<Layouts.app flash={@flash}>
  <.header>
    Pricing
    <:subtitle>Simple plans. No per-ticket charges.</:subtitle>
  </.header>

  <div class="flex flex-wrap gap-2">
    <.status_badge
      :for={status <- [:open, :pending, :on_hold, :resolved, :closed]}
      status={status}
    />
  </div>

  <div class="grid gap-6 sm:grid-cols-3 mt-8">
    <.pricing_card
      :for={plan <- @plans}
      name={plan.name}
      price={plan.price}
      seats={plan.seats}
      highlighted={plan.name == "Team"}
      id={"plan-#{String.downcase(plan.name)}"}
    >
      <:feature :for={feature <- plan.features}>{feature}</:feature>
      <:cta>Choose {plan.name}</:cta>
    </.pricing_card>
  </div>

  <button class="btn btn-primary phx-click-loading:btn-disabled">
    Save
  </button>
</Layouts.app>
